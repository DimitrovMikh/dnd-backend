# Allgemeine Projekt-Einstellungen
PROJECT_NAME="D&D Campaign Manager API"
ENVIRONMENT="development"

# JWT-Sicherheit
SECRET_KEY="HIER_DEINEN_ZUFÄLLIGEN_32_CHAR_HEX_KEY_EINTRAGEN"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Datenbank-Verbindung (Lokal: SQLite | Produktion: PostgreSQL)
DATABASE_URL="sqlite+aiosqlite:///./dnd.db"
# DATABASE_URL="postgresql+asyncpg://dnd_user:PASSWORT@db:5432/dnd_db"

# Optional: PostgreSQL Core Credentials (für Produktion)
# POSTGRES_USER="dnd_user"
# POSTGRES_PASSWORD="HIER_POSTGRES_PASSWORT"
# POSTGRES_DB="dnd_db"

# CORS / Erlaubte Frontend-Origins (JSON-Array Format)
ALLOWED_ORIGINS=["http://localhost:5173"]